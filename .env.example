# RedKross Academy - environment template. Copy to .env (never commit .env).

# --- Required (server) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Long random value, e.g. `openssl rand -hex 32`. Changing it invalidates every issued certificate.
CREDENTIAL_SIGNING_SECRET=

# --- Identity ---
# Firebase project whose ID tokens the API accepts
FIREBASE_PROJECT_ID=academy-redkross
# Optional: service-account JSON (single line) to also reject revoked tokens
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional bootstrap admins (Google-verified emails, comma separated). Prefer users.role='super_admin'.
ADMIN_EMAILS=

# --- Public URLs / network ---
PUBLIC_BASE_URL=https://academy.redkross.org.in
# Extra CORS origins, comma separated (production already allows academy.redkross.org.in)
ALLOWED_ORIGINS=
# Number of trusted reverse proxies in front of Express (e.g. 1 behind Cloudflare or nginx)
TRUST_PROXY=

# --- Email (Resend) ---
RESEND_API_KEY=
ADMIN_INBOX_EMAIL=
MAIL_FROM=RedKross Academy <noreply@redkross.org.in>

# --- Automation (n8n) ---
N8N_WEBHOOK_URL=
# Shared secret; n8n should verify the X-RedKross-Signature header (sha256 HMAC of the body)
N8N_WEBHOOK_SECRET=

# --- Labs (optional; without it the built-in simulator is used) ---
E2B_API_KEY=

# --- Client (Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=academy-redkross.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=academy-redkross
VITE_FIREBASE_APP_ID=
# Only set when running the Socket.io server
VITE_SOCKET_URL=
# Optional: numeric id of the RedKross LinkedIn company page (shows the logo on "Add to LinkedIn profile")
VITE_LINKEDIN_ORG_ID=
